# EmailJS — create these in your EmailJS dashboard (https://dashboard.emailjs.com)
# Email Services > your service
VITE_EMAILJS_SERVICE_ID=service_xxxxxxxxx

# Email Templates > template used by the Contact page form (name, organization, email, phone, scale, message, reason)
VITE_EMAILJS_TEMPLATE_CONTACT=template_ xxxxxxx

# Email Templates > template used by the homepage "Request a demo" form (name, organization, email, phone, branches, message)
VITE_EMAILJS_TEMPLATE_DEMO=template_xxxxxxx

# Account > General > Public Key
VITE_EMAILJS_PUBLIC_KEY=xxxxxxxxx
