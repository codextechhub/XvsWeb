# EmailJS — create these in your EmailJS dashboard (https://dashboard.emailjs.com)
# Email Services > your service
VITE_EMAILJS_SERVICE_ID=service_xxxxxxxxx

# Email Templates > template used by the Contact page form (name, organization, email, phone, scale, message, reason)
VITE_EMAILJS_TEMPLATE_CONTACT=template_ xxxxxxx

# Email Templates > template used by the homepage "Request a demo" form (name, organization, email, phone, branches, message)
VITE_EMAILJS_TEMPLATE_DEMO=template_xxxxxxx

# Account > General > Public Key
VITE_EMAILJS_PUBLIC_KEY=xxxxxxxxx

# ── Analytics (optional): set ONE of these to start counting visitors ──
# Plausible (cookie-free): the domain you added at plausible.io
VITE_PLAUSIBLE_DOMAIN=
# Self-hosted Plausible only: the address of your script
VITE_PLAUSIBLE_SRC=
# Google Analytics 4: your measurement ID
VITE_GA4_ID=

# ── Search & link previews ──
# The site's public address, used for the sitemap, canonical links and share previews.
# On Render, set this in the static site's Environment tab to your own domain
# (without it the build uses the onrender.com address). Example: https://xvs.codexng.com
SITE_URL=

# ── Search engine ownership (optional, read at build time) ──
# Google Search Console → Add property → HTML tag: paste only the content="…" value
GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools → Add site → HTML meta tag (msvalidate.01): paste only the content value
BING_SITE_VERIFICATION=
